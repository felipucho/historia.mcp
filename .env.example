# Copiar a .env (raíz del proyecto). Todo es opcional: estos son los defaults.

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Lista blanca separada por comas. Aplica a REST (CORS) y al header Origin del WebSocket. '*' no se admite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rutas relativas se resuelven desde la raíz del proyecto.
DATA_FILE=fundacion.json
IA_CONFIG_DIR=ia_config

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=90
# true: el backend no arranca si Ollama no responde o falta el modelo.
OLLAMA_REQUIRED=false

# --- MCP ---
MCP_CONNECT_TIMEOUT=20
MCP_CALL_TIMEOUT=15
MCP_RETRY_BASE=2
MCP_RETRY_MAX=60

# --- Agente ---
AGENT_MAX_ITERATIONS=5
HISTORY_MAX_TURNS=6

# --- Límites WebSocket (en memoria, un solo proceso) ---
WS_MAX_CONNECTIONS_PER_IP=5
WS_RATE_CAPACITY=5
WS_RATE_REFILL_PER_MINUTE=10
